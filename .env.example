# Shopify App credentials (from your Shopify Partner dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# The public URL of your deployed app (no trailing slash)
SHOPIFY_APP_URL=https://your-app.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AES-256-GCM encryption key — 32 random bytes as a 64-character hex string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key

# iron-session secret — minimum 32 characters
SESSION_SECRET=your_session_secret_at_least_32_characters_long

# Shared secret between this app and cron-job.org
# Set as a custom header X-Cron-Secret on the POST /api/cron request in cron-job.org
CRON_SECRET=your_cron_secret

# Resend email sending
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
